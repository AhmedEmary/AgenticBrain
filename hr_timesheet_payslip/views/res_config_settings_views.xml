<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_inherit_hr_ts_payslip"
                model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr_ts_payslip</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hr_payroll.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='hr_payroll_settings']" position="after">
                    <block title="Timesheet-driven Payslips"
                           name="hr_ts_payslip_settings">
                        <setting id="hr_ts_payslip_validated_only_setting"
                                 help="When on, only timesheet lines whose 'validated' flag is True are summed. Requires the Timesheets Validation feature.">
                            <field name="hr_ts_payslip_validated_only"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
