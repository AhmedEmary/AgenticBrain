<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Prices the timesheet hours.
            Line total in Odoo 19 = result * result_qty * (result_rate / 100).
            We therefore put hourly_wage in `result` and hours in `result_qty`
            so they multiply exactly ONCE. Do NOT also multiply hours into
            `result` or the line will double-count.
        -->
        <record id="rule_timesheet_basic" model="hr.salary.rule">
            <field name="name">Timesheet Pay (Hourly)</field>
            <field name="code">TSPAY</field>
            <field name="category_id" ref="hr_payroll.BASIC"/>
            <field name="struct_id" ref="hr_payroll.default_structure"/>
            <field name="sequence">5</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = ('TS_HOURS' in inputs) and (inputs['TS_HOURS'].amount &gt; 0) and version.wage_type == 'hourly'</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">
result_qty = inputs['TS_HOURS'].amount
result = version.hourly_wage
result_rate = 100.0
            </field>
        </record>

    </data>
</odoo>
